[Unit]
Description=SecureAPK Flask App
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/SecureAPK
Environment="PATH=/home/ubuntu/SecureAPK/venv/bin"
ExecStart=/home/ubuntu/SecureAPK/venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
